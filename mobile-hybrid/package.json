{
  "name": "neobank-hybrid-mobile",
  "version": "1.0.0",
  "description": "NeoBank Hybrid Mobile Application (React Native Web)",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "react-scripts start",
    "build:web": "react-scripts build",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace NeoBank.xcworkspace -scheme NeoBank -configuration Release",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-web": "^0.19.0",
    "react-navigation": "^4.4.4",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/stack": "^6.3.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-reanimated": "^3.3.0",
    "react-native-screens": "^3.22.0",
    "react-native-safe-area-context": "^4.6.0",
    "react-native-vector-icons": "^10.0.0",
    "axios": "^1.4.0",
    "@react-native-async-storage/async-storage": "^1.19.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-svg": "^13.10.0",
    "react-native-linear-gradient": "^2.8.0",
    "react-native-image-picker": "^5.6.0",
    "react-native-document-picker": "^9.0.0",
    "react-native-webview": "^13.2.0",
    "react-native-biometrics": "^3.0.1",
    "react-native-push-notification": "^8.1.1",
    "react-native-permissions": "^3.8.0",
    "react-native-netinfo": "^9.4.0",
    "react-native-device-info": "^10.8.0",
    "date-fns": "^2.30.0",
    "formik": "^2.4.2",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/runtime": "^7.22.0",
    "@react-native/eslint-config": "^0.72.0",
    "@react-native/metro-config": "^0.72.0",
    "@testing-library/react-native": "^12.1.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "babel-jest": "^29.5.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "metro-react-native-babel-preset": "^0.76.0",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=16"
  }
}
