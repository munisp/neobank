{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "environmentName": {
            "type": "string",
            "defaultValue": "neobank",
            "metadata": {
                "description": "A unique prefix for all resources."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "The location for all resources."
            }
        },
        "sqlAdminLogin": {
            "type": "string",
            "metadata": {
                "description": "Administrator login name for the SQL Server."
            }
        },
        "sqlAdminPassword": {
            "type": "securestring",
            "metadata": {
                "description": "Administrator password for the SQL Server. Use a secure method like Key Vault in production."
            }
        },
        "appServicePlanSku": {
            "type": "string",
            "defaultValue": "P1v3",
            "allowedValues": [ "P1v3", "P2v3", "P3v3" ],
            "metadata": {
                "description": "SKU for the App Service Plan (e.g., P1v3 for production with VNet integration and scaling)."
            }
        },
        "appServicePlanInstanceCount": {
            "type": "int",
            "defaultValue": 3,
            "metadata": {
                "description": "Initial number of instances for the App Service Plan (for HA)."
            }
        },
        "sqlSkuName": {
            "type": "string",
            "defaultValue": "GP_Gen5_2",
            "metadata": {
                "description": "SKU for Azure SQL Database (e.g., GP_Gen5_2 for General Purpose, 2 vCores)."
            }
        },
        "redisSkuName": {
            "type": "string",
            "defaultValue": "Premium",
            "allowedValues": [ "Premium" ],
            "metadata": {
                "description": "SKU for Azure Cache for Redis. Premium is required for Private Link."
            }
        }
    },
    "variables": {
        "resourceNamePrefix": "[toLower(parameters('environmentName'))]",
        "vnetName": "[concat(variables('resourceNamePrefix'), '-vnet')]",
        "vnetAddressPrefix": "10.0.0.0/16",
        "appGatewaySubnetPrefix": "10.0.0.0/24",
        "appServiceSubnetPrefix": "10.0.1.0/24",
        "sqlPrivateEndpointSubnetPrefix": "10.0.2.0/24",
        "redisPrivateEndpointSubnetPrefix": "10.0.3.0/24",
        "keyVaultName": "[concat(variables('resourceNamePrefix'), '-kv')]",
        "sqlServerName": "[concat(variables('resourceNamePrefix'), '-sql-srv')]",
        "sqlDatabaseName": "[concat(variables('resourceNamePrefix'), '-sqldb')]",
        "redisCacheName": "[concat(variables('resourceNamePrefix'), '-redis')]",
        "appServicePlanName": "[concat(variables('resourceNamePrefix'), '-asp')]",
        "webAppName": "[concat(variables('resourceNamePrefix'), '-webapp')]",
        "appGatewayName": "[concat(variables('resourceNamePrefix'), '-agw')]",
        "appInsightsName": "[concat(variables('resourceNamePrefix'), '-appins')]",
        "appGatewayPublicIpName": "[concat(variables('resourceNamePrefix'), '-agw-pip')]",
        "appGatewayFrontendIpName": "appGatewayFrontendIP",
        "appGatewayBackendPoolName": "appGatewayBackendPool",
        "appGatewayHttpSettingsName": "appGatewayHttpSettings",
        "appGatewayListenerName": "appGatewayListener",
        "appGatewayRuleName": "appGatewayRule"
    },
    "resources": [
        // 1. Key Vault
        {
            "type": "Microsoft.KeyVault/vaults",
            "apiVersion": "2021-11-01",
            "name": "[variables('keyVaultName')]",
            "location": "[parameters('location')]",
            "properties": {
                "sku": {
                    "family": "A",
                    "name": "standard"
                },
                "tenantId": "[subscription().tenantId]",
                "accessPolicies": [],
                "enabledForDeployment": true,
                "enabledForTemplateDeployment": true,
                "enabledForDiskEncryption": true
            }
        },
        // 2. Virtual Network and Subnets
        {
            "type": "Microsoft.Network/virtualNetworks",
            "apiVersion": "2021-08-01",
            "name": "[variables('vnetName')]",
            "location": "[parameters('location')]",
            "properties": {
                "addressSpace": {
                    "addressPrefixes": [
                        "[variables('vnetAddressPrefix')]"
                    ]
                },
                "subnets": [
                    {
                        "name": "AppGatewaySubnet",
                        "properties": {
                            "addressPrefix": "[variables('appGatewaySubnetPrefix')]"
                        }
                    },
                    {
                        "name": "AppServiceSubnet",
                        "properties": {
                            "addressPrefix": "[variables('appServiceSubnetPrefix')]",
                            "delegations": [
                                {
                                    "name": "delegation",
                                    "properties": {
                                        "serviceName": "Microsoft.Web/serverFarms"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "name": "SqlPrivateEndpointSubnet",
                        "properties": {
                            "addressPrefix": "[variables('sqlPrivateEndpointSubnetPrefix')]",
                            "privateEndpointNetworkPolicies": "Disabled",
                            "privateLinkServiceNetworkPolicies": "Disabled"
                        }
                    },
                    {
                        "name": "RedisPrivateEndpointSubnet",
                        "properties": {
                            "addressPrefix": "[variables('redisPrivateEndpointSubnetPrefix')]",
                            "privateEndpointNetworkPolicies": "Disabled",
                            "privateLinkServiceNetworkPolicies": "Disabled"
                        }
                    }
                ]
            }
        },
        // 3. Azure SQL Server and Database
        {
            "type": "Microsoft.Sql/servers",
            "apiVersion": "2021-11-01",
            "name": "[variables('sqlServerName')]",
            "location": "[parameters('location')]",
            "properties": {
                "administratorLogin": "[parameters('sqlAdminLogin')]",
                "administratorLoginPassword": "[parameters('sqlAdminPassword')]",
                "version": "12.0",
                "publicNetworkAccess": "Disabled" // Security best practice
            }
        },
        {
            "type": "Microsoft.Sql/servers/databases",
            "apiVersion": "2021-11-01",
            "name": "[concat(variables('sqlServerName'), '/', variables('sqlDatabaseName'))]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
            ],
            "sku": {
                "name": "[split(parameters('sqlSkuName'), '_')[0]]", // e.g., GP
                "tier": "[split(parameters('sqlSkuName'), '_')[0]]", // e.g., GeneralPurpose
                "capacity": "[split(parameters('sqlSkuName'), '_')[2]]" // e.g., 2 (vCores)
            },
            "properties": {
                "collation": "SQL_Latin1_General_CP1_CI_AS",
                "maxSizeGB": 250,
                "zoneRedundant": true // High Availability
            }
        },
        // 4. Azure Cache for Redis
        {
            "type": "Microsoft.Cache/redis",
            "apiVersion": "2021-06-01",
            "name": "[variables('redisCacheName')]",
            "location": "[parameters('location')]",
            "properties": {
                "sku": {
                    "name": "[parameters('redisSkuName')]",
                    "family": "P",
                    "capacity": 1 // C1, P1, etc.
                },
                "minimumTlsVersion": "1.2", // Security best practice
                "enableNonSslPort": false, // Security best practice
                "redisConfiguration": {
                    "maxmemory-policy": "allkeys-lru"
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
            ]
        },
        // 5. Application Insights
        {
            "type": "Microsoft.Insights/components",
            "apiVersion": "2020-02-02",
            "name": "[variables('appInsightsName')]",
            "location": "[parameters('location')]",
            "kind": "web",
            "properties": {
                "Application_Type": "web"
            }
        },
        // 6. App Service Plan
        {
            "type": "Microsoft.Web/serverfarms",
            "apiVersion": "2021-03-01",
            "name": "[variables('appServicePlanName')]",
            "location": "[parameters('location')]",
            "sku": {
                "name": "[parameters('appServicePlanSku')]",
                "capacity": "[parameters('appServicePlanInstanceCount')]"
            },
            "properties": {
                "reserved": true, // For Linux
                "perSiteScaling": false,
                "zoneRedundant": true, // High Availability
                "targetWorkerCount": "[parameters('appServicePlanInstanceCount')]"
            }
        },
        // 7. App Service (Web App)
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2021-03-01",
            "name": "[variables('webAppName')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
                "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
                "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
            ],
            "identity": {
                "type": "SystemAssigned" // Managed Identity for Key Vault access
            },
            "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
                "httpsOnly": true, // Security best practice
                "siteConfig": {
                    "appSettings": [
                        {
                            "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                            "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').InstrumentationKey]"
                        },
                        {
                            "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                            "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
                        },
                        {
                            "name": "DatabaseConnectionString",
                            "value": "[concat('@Microsoft.KeyVault(SecretUri=', reference(variables('keyVaultName')).vaultUri, 'secrets/SqlConnectionString/'))]" // Key Vault Reference
                        }
                    ],
                    "minTlsVersion": "1.2" // Security best practice
                },
                "virtualNetworkSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'AppServiceSubnet')]" // VNet Integration
            }
        },
        // 8. Private Endpoints for SQL and Redis
        {
            "type": "Microsoft.Network/privateEndpoints",
            "apiVersion": "2021-08-01",
            "name": "[concat(variables('sqlServerName'), '-pe')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
                "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
            ],
            "properties": {
                "subnet": {
                    "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'SqlPrivateEndpointSubnet')]"
                },
                "privateLinkServiceConnections": [
                    {
                        "name": "[concat(variables('sqlServerName'), '-pe-connection')]",
                        "properties": {
                            "privateLinkServiceId": "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
                            "groupIds": [
                                "sqlServer"
                            ]
                        }
                    }
                ]
            }
        },
        {
            "type": "Microsoft.Network/privateEndpoints",
            "apiVersion": "2021-08-01",
            "name": "[concat(variables('redisCacheName'), '-pe')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
                "[resourceId('Microsoft.Cache/redis', variables('redisCacheName'))]"
            ],
            "properties": {
                "subnet": {
                    "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'RedisPrivateEndpointSubnet')]"
                },
                "privateLinkServiceConnections": [
                    {
                        "name": "[concat(variables('redisCacheName'), '-pe-connection')]",
                        "properties": {
                            "privateLinkServiceId": "[resourceId('Microsoft.Cache/redis', variables('redisCacheName'))]",
                            "groupIds": [
                                "redisCache"
                            ]
                        }
                    }
                ]
            }
        },
        // 9. Public IP for Application Gateway
        {
            "type": "Microsoft.Network/publicIPAddresses",
            "apiVersion": "2021-08-01",
            "name": "[variables('appGatewayPublicIpName')]",
            "location": "[parameters('location')]",
            "sku": {
                "name": "Standard" // Required for Zone Redundancy
            },
            "properties": {
                "publicIPAllocationMethod": "Static"
            },
            "zones": [
                "1",
                "2",
                "3"
            ] // High Availability
        },
        // 10. Application Gateway
        {
            "type": "Microsoft.Network/applicationGateways",
            "apiVersion": "2021-08-01",
            "name": "[variables('appGatewayName')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
                "[resourceId('Microsoft.Network/publicIPAddresses', variables('appGatewayPublicIpName'))]",
                "[resourceId('Microsoft.Web/sites', variables('webAppName'))]"
            ],
            "sku": {
                "name": "WAF_v2", // Security best practice (WAF)
                "tier": "WAF_v2",
                "capacity": 2 // Initial instance count
            },
            "zones": [
                "1",
                "2",
                "3"
            ], // High Availability
            "properties": {
                "autoscaleConfiguration": {
                    "minCapacity": 2,
                    "maxCapacity": 10 // Auto-scaling
                },
                "gatewayIPConfigurations": [
                    {
                        "name": "appGatewayIpConfig",
                        "properties": {
                            "subnet": {
                                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'AppGatewaySubnet')]"
                            }
                        }
                    }
                ],
                "frontendIPConfigurations": [
                    {
                        "name": "[variables('appGatewayFrontendIpName')]",
                        "properties": {
                            "publicIPAddress": {
                                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('appGatewayPublicIpName'))]"
                            }
                        }
                    }
                ],
                "frontendPorts": [
                    {
                        "name": "port_443",
                        "properties": {
                            "port": 443
                        }
                    }
                ],
                "backendAddressPools": [
                    {
                        "name": "[variables('appGatewayBackendPoolName')]",
                        "properties": {
                            "backendAddresses": [
                                {
                                    "fqdn": "[concat(variables('webAppName'), '.azurewebsites.net')]" // Point to App Service
                                }
                            ]
                        }
                    }
                ],
                "backendHttpSettingsCollection": [
                    {
                        "name": "[variables('appGatewayHttpSettingsName')]",
                        "properties": {
                            "port": 443,
                            "protocol": "Https",
                            "cookieBasedAffinity": "Disabled",
                            "requestTimeout": 20,
                            "probeEnabled": false,
                            "pickHostNameFromBackendAddress": true // Important for App Service
                        }
                    }
                ],
                "httpListeners": [
                    {
                        "name": "[variables('appGatewayListenerName')]",
                        "properties": {
                            "frontendIPConfiguration": {
                                "id": "[resourceId('Microsoft.Network/applicationGateways/frontendIPConfigurations', variables('appGatewayName'), variables('appGatewayFrontendIpName'))]"
                            },
                            "frontendPort": {
                                "id": "[resourceId('Microsoft.Network/applicationGateways/frontendPorts', variables('appGatewayName'), 'port_443')]"
                            },
                            "protocol": "Https",
                            "sslCertificate": null, // Placeholder: requires certificate to be uploaded
                            "hostName": "[concat(variables('webAppName'), '.azurewebsites.net')]" // Use App Service default domain for simplicity
                        }
                    }
                ],
                "requestRoutingRules": [
                    {
                        "name": "[variables('appGatewayRuleName')]",
                        "properties": {
                            "ruleType": "Basic",
                            "httpListener": {
                                "id": "[resourceId('Microsoft.Network/applicationGateways/httpListeners', variables('appGatewayName'), variables('appGatewayListenerName'))]"
                            },
                            "backendAddressPool": {
                                "id": "[resourceId('Microsoft.Network/applicationGateways/backendAddressPools', variables('appGatewayName'), variables('appGatewayBackendPoolName'))]"
                            },
                            "backendHttpSettings": {
                                "id": "[resourceId('Microsoft.Network/applicationGateways/backendHttpSettingsCollection', variables('appGatewayName'), variables('appGatewayHttpSettingsName'))]"
                            }
                        }
                    }
                ],
                "webApplicationFirewallConfiguration": {
                    "enabled": true,
                    "firewallMode": "Detection", // Can be changed to Prevention
                    "ruleSetType": "OWASP",
                    "ruleSetVersion": "3.1"
                }
            }
        },
        // 11. Auto-scale settings for App Service Plan
        {
            "type": "Microsoft.Insights/autoscalesettings",
            "apiVersion": "2022-10-01",
            "name": "[concat(variables('appServicePlanName'), '-autoscale')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
            ],
            "properties": {
                "targetResourceUri": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
                "enabled": true,
                "profiles": [
                    {
                        "name": "ScaleOutIn",
                        "capacity": {
                            "minimum": "[string(parameters('appServicePlanInstanceCount'))]",
                            "maximum": "10",
                            "default": "[string(parameters('appServicePlanInstanceCount'))]"
                        },
                        "rules": [
                            {
                                "metricTrigger": {
                                    "metricName": "CpuPercentage",
                                    "metricResourceUri": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
                                    "timeGrain": "PT1M",
                                    "statistic": "Average",
                                    "timeWindow": "PT5M",
                                    "timeAggregation": "Average",
                                    "operator": "GreaterThan",
                                    "threshold": 70
                                },
                                "scaleAction": {
                                    "direction": "Increase",
                                    "type": "ChangeCount",
                                    "value": "1",
                                    "cooldown": "PT5M"
                                }
                            },
                            {
                                "metricTrigger": {
                                    "metricName": "CpuPercentage",
                                    "metricResourceUri": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
                                    "timeGrain": "PT1M",
                                    "statistic": "Average",
                                    "timeWindow": "PT5M",
                                    "timeAggregation": "Average",
                                    "operator": "LessThan",
                                    "threshold": 30
                                },
                                "scaleAction": {
                                    "direction": "Decrease",
                                    "type": "ChangeCount",
                                    "value": "1",
                                    "cooldown": "PT5M"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        // 12. NSG for App Gateway Subnet (Optional but good practice)
        {
            "type": "Microsoft.Network/networkSecurityGroups",
            "apiVersion": "2021-08-01",
            "name": "[concat(variables('resourceNamePrefix'), '-agw-nsg')]",
            "location": "[parameters('location')]",
            "properties": {
                "securityRules": [
                    {
                        "name": "Allow_Inbound_HTTP_HTTPS",
                        "properties": {
                            "priority": 100,
                            "direction": "Inbound",
                            "access": "Allow",
                            "protocol": "*",
                            "sourceAddressPrefix": "Internet",
                            "sourcePortRange": "*",
                            "destinationAddressPrefix": "*",
                            "destinationPortRange": "80,443"
                        }
                    }
                ]
            }
        },
        // Link NSG to App Gateway Subnet
        {
            "type": "Microsoft.Network/virtualNetworks/subnets",
            "apiVersion": "2021-08-01",
            "name": "[concat(variables('vnetName'), '/AppGatewaySubnet')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
                "[resourceId('Microsoft.Network/networkSecurityGroups', concat(variables('resourceNamePrefix'), '-agw-nsg'))]"
            ],
            "properties": {
                "addressPrefix": "[variables('appGatewaySubnetPrefix')]",
                "networkSecurityGroup": {
                    "id": "[resourceId('Microsoft.Network/networkSecurityGroups', concat(variables('resourceNamePrefix'), '-agw-nsg'))]"
                }
            }
        }
        // End of resources
    ],
    "outputs": {
        "webAppUrl": {
            "type": "string",
            "value": "[concat('https://', variables('webAppName'), '.azurewebsites.net')]"
        },
        "applicationGatewayPublicIp": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('appGatewayPublicIpName'))).ipAddress]"
        },
        "keyVaultUri": {
            "type": "string",
            "value": "[reference(variables('keyVaultName')).properties.vaultUri]"
        }
    }
}