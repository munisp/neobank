# Stage 1: Base Image
# Use a Node.js 20 base image for the build process.
FROM node:20-alpine AS base

# Set working directory
WORKDIR /app

# Stage 2: Dependency Installation (Caching Layer)
FROM base AS deps

# Install dependencies only when package.json or package-lock.json changes
COPY package.json yarn.lock ./
# Use yarn or npm based on the project. Assuming yarn for modern Next.js projects.
# If using npm, replace 'yarn' with 'npm install'
RUN apk add --no-cache git python3 make g++ \
    && yarn install --frozen-lockfile \
    && apk del git python3 make g++

# Stage 3: Builder Stage
FROM base AS builder

# Copy dependencies from the deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy the rest of the application source code
COPY . .

# Build the Next.js application for production
# NEXT_TELEMETRY_DISABLED=1 is a good practice to disable telemetry during build
# The 'output: "standalone"' configuration in next.config.js is crucial for this stage
# It creates a minimal folder with only the necessary files and dependencies.
ENV NEXT_TELEMETRY_DISABLED 1
RUN yarn build

# Stage 4: Production Runner (Minimal and Secure)
# Use a minimal base image for the final production image for security and size
FROM node:20-alpine AS runner

# Next.js recommends a non-root user for security
# Create a non-root user and group
RUN addgroup --system --gid 1001 nextjs \
    && adduser --system --uid 1001 nextjs

# Set the environment variables for Next.js
ENV NODE_ENV production
# Set the port the application will listen on
ENV PORT 3000

# Copy the standalone output from the builder stage
# The standalone output is located in .next/standalone
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
# Copy the public and static files
COPY --from=builder --chown=nextjs:nextjs /app/public ./public
# Copy the next.js static assets
COPY --from=builder --chown=nextjs:nextjs /app/.next/static ./.next/static

# Set the user to the non-root user
USER nextjs

# Expose the port
EXPOSE 3000

# Health Check (Optional but recommended)
# This checks if the server is responding to requests on the exposed port
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:3000/ || exit 1

# Start the Next.js server
# The standalone output includes the necessary server file at the root
CMD ["node", "server.js"]