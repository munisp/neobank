# Stage 1: Builder - Prepare the Nginx configuration with environment variable support
# We use a separate stage to process the configuration file using envsubst,
# which is a common pattern for Nginx in Docker to handle environment variables.
FROM alpine:3.18 as builder

# Install necessary tools for configuration templating
RUN apk add --no-cache gettext

# Copy the Nginx configuration template
COPY nginx.conf /etc/nginx/templates/nginx.conf.template

# Stage 2: Final Image - Minimal and secure Nginx reverse proxy
FROM nginx:alpine as final

# 1. Security Best Practices: Non-root user
# Nginx:alpine already runs as a non-root user (nginx) by default, but we'll
# explicitly switch to it after setting up necessary directories.

# 2. Environment Variable Support
# Copy the templated configuration from the builder stage
COPY --from=builder /etc/nginx/templates/nginx.conf.template /etc/nginx/templates/nginx.conf.template

# Create a custom entrypoint script to substitute environment variables
# and then execute the main Nginx process.
RUN echo '#!/bin/sh\n\
# Substitute environment variables in the Nginx configuration template\n\
envsubst '\''$$NGINX_HOST_NAME $$NGINX_CERT_FILE $$NGINX_KEY_FILE $$UPSTREAM_SERVICE_HOST $$UPSTREAM_SERVICE_PORT'\'' < /etc/nginx/templates/nginx.conf.template > /etc/nginx/conf.d/default.conf\n\
\n\
# Execute the main Nginx process\n\
exec nginx -g '\''daemon off;'\''\n\
' > /usr/local/bin/docker-entrypoint.sh \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

# 3. Custom Configuration and SSL Support
# Create a directory for SSL certificates and a dummy certificate for initial build
# In a real production environment, these should be mounted as volumes.
RUN mkdir -p /etc/nginx/certs \
    && openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/certs/nginx.key \
    -out /etc/nginx/certs/nginx.crt \
    -subj "/C=US/ST=State/L=City/O=Organization/OU=Unit/CN=localhost"

# Remove default Nginx configuration to use our templated one
RUN rm /etc/nginx/conf.d/default.conf

# 4. Proper Caching Layers
# The base image (nginx:alpine) handles most of the caching layers well.
# We ensure that the configuration copy is done after the base image layers.

# 5. Production Optimizations
# The use of nginx:alpine is a good start for a minimal image.
# The custom entrypoint ensures the configuration is fresh on container start.

# Expose ports
EXPOSE 80 443

# 6. Health Checks (Note: This is defined in the docker-compose/orchestration,
# but we can include a command that can be used for a simple health check)
# The default CMD is usually 'nginx -g "daemon off;"'
# We override the entrypoint to use our custom script
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# The CMD is not strictly needed since the entrypoint executes nginx,
# but we can keep it for clarity if we were to use the default entrypoint.
# CMD ["nginx", "-g", "daemon off;"]
