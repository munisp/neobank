# Stage 1: Build the React/Vite application
# Use a minimal Node.js 20 image for the build process
FROM node:20-alpine AS builder

# Set the working directory
WORKDIR /app

# Copy package.json and lock file first to leverage Docker cache
# This layer only invalidates if package.json or lock file changes
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application source code
COPY . .

# Build the application
# The output directory is typically 'dist' for Vite
RUN npm run build

# Stage 2: Serve the application with Nginx
# Use a minimal Nginx image for the final production image
FROM nginx:stable-alpine AS final

# Install bash for the entrypoint script
RUN apk add --no-cache bash

# Security Best Practice: Run as a non-root user
# Nginx stable-alpine already includes a non-root user 'nginx' (UID 101)
# We will use this user.

# Copy the custom Nginx configuration
# We will create a default.conf later, assuming it's in the same directory
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built application files from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Set permissions for the non-root user
# This is crucial for security and ensuring Nginx can read the files
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Expose port 80 (default Nginx port)
EXPOSE 80

# Health Check (Requirement 6)
# Checks if Nginx is running and serving content
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/ || exit 1

# User Best Practice: Switch to the non-root user
USER nginx

# Copy the entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Command to run Nginx
ENTRYPOINT ["/docker-entrypoint.sh"]
# Nginx is configured to run in the foreground by default in this image
CMD ["nginx", "-g", "daemon off;"]