# ===== NeoBank Staging Environment Variables =====
# Copy this file to .env.staging and fill in the values

# ===== Application Settings =====
NODE_ENV=staging
APP_NAME=NeoBank Staging
APP_URL=https://staging.neobank.com
API_URL=https://api-staging.neobank.com
PWA_URL=https://app-staging.neobank.com
KYC_APP_URL=https://kyc-staging.neobank.com

# ===== Database Configuration =====
DATABASE_URL=postgresql://username:password@host:5432/neobank_staging
POSTGRES_DB=neobank_staging
POSTGRES_USER=neobank_staging
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_HOST=postgres-staging.internal
POSTGRES_PORT=5432

# ===== Redis Configuration =====
REDIS_URL=redis://:password@host:6379/1
REDIS_HOST=redis-staging.internal
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME>
REDIS_DB=1

# ===== JWT & Authentication =====
JWT_SECRET=<STAGING_JWT_SECRET>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<STAGING_REFRESH_SECRET>
JWT_REFRESH_EXPIRES_IN=30d

# ===== Email Configuration (Test Mode) =====
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=<MAILTRAP_USER>
SMTP_PASSWORD=<MAILTRAP_PASSWORD>
EMAIL_FROM=staging@neobank.com

# ===== SMS Configuration (Test Mode) =====
SMS_PROVIDER=twilio
SMS_API_KEY=<TWILIO_TEST_SID>
SMS_API_SECRET=<TWILIO_TEST_TOKEN>
SMS_FROM_NUMBER=+15005550006

# ===== Payment Gateway (Test Mode) =====
PAYMENT_GATEWAY_PROVIDER=stripe
PAYMENT_GATEWAY_KEY=<STRIPE_TEST_KEY>
PAYMENT_GATEWAY_PUBLISHABLE_KEY=<STRIPE_TEST_PUBLISHABLE_KEY>

# ===== File Storage =====
AWS_S3_BUCKET=neobank-staging-files
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# ===== Feature Flags (All Enabled for Testing) =====
FEATURE_CRYPTO_TRADING=true
FEATURE_STOCK_TRADING=true
FEATURE_INSURANCE=true
FEATURE_LOANS=true

# ===== Monitoring & Logging =====
LOG_LEVEL=debug
DEBUG=true
VERBOSE_LOGGING=true

# ===== CORS (Allow All for Testing) =====
CORS_ORIGIN=*

# ===== Rate Limiting (Relaxed) =====
RATE_LIMIT_MAX_REQUESTS=1000

# ===== Maintenance Mode =====
MAINTENANCE_MODE=false
