# ===== NeoBank Production Environment Variables =====
# Copy this file to .env.production and fill in the values
# NEVER commit the actual .env.production file to version control

# ===== Application Settings =====
NODE_ENV=production
APP_NAME=NeoBank
APP_URL=https://neobank.com
API_URL=https://api.neobank.com
PWA_URL=https://app.neobank.com
KYC_APP_URL=https://kyc.neobank.com

# ===== Database Configuration =====
DATABASE_URL=postgresql://username:password@host:5432/neobank_prod
POSTGRES_DB=neobank_prod
POSTGRES_USER=neobank_prod
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_HOST=postgres.internal
POSTGRES_PORT=5432

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=30000

# ===== Redis Configuration =====
REDIS_URL=redis://:password@host:6379/0
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
REDIS_DB=0
REDIS_TTL=3600

# ===== JWT & Authentication =====
JWT_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>

# ===== API Keys =====
API_KEY=<CHANGE_ME_API_KEY>
API_SECRET=<CHANGE_ME_API_SECRET>

# ===== Email Configuration (SMTP) =====
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=<SENDGRID_API_KEY>
EMAIL_FROM=noreply@neobank.com
EMAIL_FROM_NAME=NeoBank

# ===== SMS Configuration =====
SMS_PROVIDER=twilio
SMS_API_KEY=<TWILIO_ACCOUNT_SID>
SMS_API_SECRET=<TWILIO_AUTH_TOKEN>
SMS_FROM_NUMBER=+1234567890

# ===== Payment Gateway =====
PAYMENT_GATEWAY_PROVIDER=stripe
PAYMENT_GATEWAY_KEY=<STRIPE_SECRET_KEY>
PAYMENT_GATEWAY_PUBLISHABLE_KEY=<STRIPE_PUBLISHABLE_KEY>
PAYMENT_GATEWAY_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# Alternative: Paystack
# PAYSTACK_SECRET_KEY=<PAYSTACK_SECRET_KEY>
# PAYSTACK_PUBLIC_KEY=<PAYSTACK_PUBLIC_KEY>

# ===== File Storage (S3 Compatible) =====
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_KEY>
AWS_REGION=us-east-1
AWS_S3_BUCKET=neobank-prod-files
AWS_S3_ENDPOINT=https://s3.amazonaws.com
AWS_S3_PUBLIC_URL=https://cdn.neobank.com

# ===== KYC/KYB Verification =====
KYC_PROVIDER=onfido
KYC_API_KEY=<ONFIDO_API_KEY>
KYC_API_SECRET=<ONFIDO_API_SECRET>
KYC_WEBHOOK_SECRET=<ONFIDO_WEBHOOK_SECRET>

# Alternative: Jumio
# JUMIO_API_KEY=<JUMIO_API_KEY>
# JUMIO_API_SECRET=<JUMIO_API_SECRET>

# ===== Credit Score Provider =====
CREDIT_SCORE_PROVIDER=experian
CREDIT_SCORE_API_KEY=<EXPERIAN_API_KEY>
CREDIT_SCORE_API_SECRET=<EXPERIAN_API_SECRET>

# ===== Insurance Provider API =====
INSURANCE_API_KEY=<INSURANCE_PROVIDER_API_KEY>
INSURANCE_API_SECRET=<INSURANCE_PROVIDER_API_SECRET>

# ===== Cryptocurrency Exchange API =====
CRYPTO_EXCHANGE_API_KEY=<BINANCE_API_KEY>
CRYPTO_EXCHANGE_API_SECRET=<BINANCE_API_SECRET>

# ===== Stock Trading API =====
STOCK_API_PROVIDER=alpaca
STOCK_API_KEY=<ALPACA_API_KEY>
STOCK_API_SECRET=<ALPACA_API_SECRET>

# ===== Push Notifications =====
PUSH_NOTIFICATION_PROVIDER=fcm
FCM_SERVER_KEY=<FIREBASE_SERVER_KEY>
FCM_SENDER_ID=<FIREBASE_SENDER_ID>
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>
VAPID_SUBJECT=mailto:admin@neobank.com

# ===== Analytics =====
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=<MIXPANEL_TOKEN>
SENTRY_DSN=<SENTRY_DSN>

# ===== Monitoring & Logging =====
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== CORS Configuration =====
CORS_ORIGIN=https://neobank.com,https://app.neobank.com,https://kyc.neobank.com
CORS_CREDENTIALS=true

# ===== Security Headers =====
HELMET_ENABLED=true
CSP_ENABLED=true

# ===== SSL/TLS Configuration =====
SSL_ENABLED=true
FORCE_HTTPS=true

# ===== Backup Configuration =====
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=neobank-prod-backups

# ===== Feature Flags =====
FEATURE_CRYPTO_TRADING=true
FEATURE_STOCK_TRADING=true
FEATURE_INSURANCE=true
FEATURE_LOANS=true
FEATURE_BILL_PAYMENTS=true
FEATURE_BUDGET_TRACKING=true

# ===== Maintenance Mode =====
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We're performing scheduled maintenance. We'll be back soon!"

# ===== Third-party Integrations =====
SLACK_WEBHOOK_URL=<SLACK_WEBHOOK_URL>
PAGERDUTY_API_KEY=<PAGERDUTY_API_KEY>

# ===== Mobile App Configuration =====
IOS_APP_ID=com.neobank.app
ANDROID_APP_ID=com.neobank.app
APP_STORE_URL=https://apps.apple.com/app/neobank/id123456789
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.neobank.app

# ===== PWA Configuration =====
PWA_MANIFEST_URL=https://app.neobank.com/manifest.json
PWA_SERVICE_WORKER_URL=https://app.neobank.com/sw.js

# ===== Compliance & Regulatory =====
COMPLIANCE_MODE=strict
AML_ENABLED=true
KYC_REQUIRED=true
GDPR_ENABLED=true
DATA_RETENTION_DAYS=2555

# ===== Localization =====
DEFAULT_LOCALE=en-NG
SUPPORTED_LOCALES=en-NG,en-US,en-GB
DEFAULT_CURRENCY=NGN
SUPPORTED_CURRENCIES=NGN,USD,GBP,EUR

# ===== Time Zone =====
TZ=Africa/Lagos

# ===== API Versioning =====
API_VERSION=v1
API_PREFIX=/api/v1

# ===== Webhooks =====
WEBHOOK_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
WEBHOOK_TIMEOUT=30000

# ===== Session Configuration =====
SESSION_COOKIE_NAME=neobank_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict
SESSION_MAX_AGE=604800000

# ===== OAuth Configuration (if using OAuth) =====
OAUTH_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
OAUTH_GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
OAUTH_FACEBOOK_APP_ID=<FACEBOOK_APP_ID>
OAUTH_FACEBOOK_APP_SECRET=<FACEBOOK_APP_SECRET>

# ===== Admin Configuration =====
ADMIN_EMAIL=admin@neobank.com
ADMIN_PHONE=+1234567890
SUPPORT_EMAIL=support@neobank.com
SUPPORT_PHONE=+1234567890

# ===== Performance Optimization =====
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TTL=3600
ENABLE_CDN=true
CDN_URL=https://cdn.neobank.com

# ===== Development/Debug (should be false in production) =====
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_PROFILING=false

# ===== Health Check =====
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000

# ===== Graceful Shutdown =====
SHUTDOWN_TIMEOUT=30000

# ===== Worker Configuration =====
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_QUEUE_NAME=neobank-jobs

# ===== Cron Jobs =====
CRON_ENABLED=true
CRON_BACKUP_SCHEDULE=0 2 * * *
CRON_REPORTS_SCHEDULE=0 6 * * 1
CRON_CLEANUP_SCHEDULE=0 3 * * *
